# Local mode is complete without an AWS account or network.
SOPHIA_PROVIDER=demo
PORT=4173
# Set this only to call Bedrock. Never put AWS credentials in public/.
# SOPHIA_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# SOPHIA_MAX_DAILY_CALLS=100
# Optional locally, required for a hosted deployment. Choose a private value.
# SOPHIA_ACCESS_CODE=
# Local filesystem persistence (default .data/state.json).
# SOPHIA_DATA_DIR=.data
# SOPHIA_TABLE is set by the AWS deployment, not required locally.
